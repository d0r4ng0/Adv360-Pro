            compatible = "zmk,behavior-mod-morph";
            label = "MJ_SC";
            bindings = <&kp SEMI>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n1: mm_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N1";
            bindings = <&kp HASH>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n2: mm_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N2";
            bindings = <&kp LBKT>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n3: mm_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N3";
            bindings = <&kp LBRC>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n4: mm_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N4";
            bindings = <&kp LPAR>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n5: mm_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N5";
            bindings = <&kp STAR>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n6: mm_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N6";
            bindings = <&kp CARET>, <&kp N6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n7: mm_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N7";
            bindings = <&kp RPAR>, <&kp N7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n8: mm_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N8";
            bindings = <&kp RBRC>, <&kp N8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n9: mm_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N9";
            bindings = <&kp RBKT>, <&kp N9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n0: mm_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N0";
            bindings = <&kp DLLR>, <&kp N0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_ea: mm_ea {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_EA";
            bindings = <&kp EXCL>, <&kp AT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_pa: mm_pa {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_PA";
            bindings = <&kp PRCNT>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n1: mj_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N1";
            bindings = <&kp HASH>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n2: mj_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N2";
            bindings = <&kp RBKT>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n3: mj_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N3";
            bindings = <&kp RBRC>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n4: mj_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N4";
            bindings = <&kp STAR>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n5: mj_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N5";
            bindings = <&kp DQT>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n6: mj_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N6";
            bindings = <&kp EQUAL>, <&kp N6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n7: mj_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N7";
            bindings = <&kp LPAR>, <&kp N7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n8: mj_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N8";
            bindings = <&kp PIPE>, <&kp N8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n9: mj_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N9";
            bindings = <&kp BSLH>, <&kp N9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n0: mj_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N0";
            bindings = <&kp DLLR>, <&kp N0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_ea: mj_ea {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_EA";
            bindings = <&kp EXCL>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_pa: mj_pa {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_PA";
            bindings = <&kp PRCNT>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        aj_n2: aj_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N2";
            bindings = <&kp N2>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n6: aj_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N6";
            bindings = <&kp N6>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n7: aj_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N7";
            bindings = <&kp N7>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n8: aj_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N8";
            bindings = <&kp N8>, <&kp DQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n9: aj_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N9";
            bindings = <&kp N9>, <&kp STAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n0: aj_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N0";
            bindings = <&kp N0>, <&kp LPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hml_mod2: hml_mod2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_MOD2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
        };

        hmr_mod2: hmr_mod2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_MOD2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        mm_lp: mm_lp {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_LP";
            bindings = <&kp LT>, <&kp PRCNT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_ga: mm_ga {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_GA";
            bindings = <&kp GT>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_ga: mj_ga {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_GA";
            bindings = <&kp GT>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        cc: cc {
            compatible = "zmk,behavior-mod-morph";
            label = "CC";
            bindings = <&kp COMMA>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dd: dd {
            compatible = "zmk,behavior-mod-morph";
            label = "DD";
            bindings = <&kp DOT>, <&kp DOT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hmr_cc: hmr_cc {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_CC";
            bindings = <&kp>, <&cc>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
        };

        hmr_dd: hmr_dd {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_DD";
            bindings = <&kp>, <&dd>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
        };

        hmr_sc: hmr_sc {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_SC";
            bindings = <&kp>, <&mj_sc>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            require-prior-idle-ms = <150>;
            quick-tap-ms = <200>;
        };

        custom_shift: custom_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "CUSTOM_SHIFT";
            #binding-cells = <0>;
            bindings = <&sk LSHIFT>, <&caps_word>;
        };
    };

    macros {
        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none>,
                <&macro_press>,
                <&kp F13>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&bt BT_SEL 0>,
                <&macro_release>;

            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none>,
                <&macro_press>,
                <&kp F14>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&bt BT_SEL 1>,
                <&macro_release>;

            label = "BT1";
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <41 42>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <32 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_reverse {
            display-name = "Base_reverse";
            bindings = <
&mm_ea         &mm_n1             &mm_n2         &mm_n3       &mm_n4     &mm_n5  &kp PSCRN                                                                    &mo 11     &mm_n6  &mm_n7    &mm_n8           &mm_n9         &mm_n0                &kp BSLH
&kp EQUAL      &kp Q              &kp W          &kp E        &kp R      &kp T   &kp INS                                                                      &kp DEL    &kp Y   &kp U     &kp I            &kp O          &kp P                 &kp MINUS
&kp TAB        &hml LCTRL A       &kp S          &kp D        &kp F      &kp G   &none      &kp LCTRL      &kp LANG2      &kp LANG1              &kp ESC      &none      &kp H   &kp J     &kp K            &kp L          &hmr LCTRL SEMI       &kp SQT
&custom_shift  &hml LC(LSHIFT) Z  &hml LGUI X    &hml LALT C  &kp V      &kp B                             &kp LGUI       &kp LS(LA(LG(LCTRL)))                          &kp N   &kp M     &hmr LALT COMMA  &hmr LGUI DOT  &hmr LC(LSHIFT) FSLH  &custom_shift
&mo 10         &kp PG_UP          &kp PAGE_DOWN  &kp LEFT     &kp RIGHT          &kp BSPC   &custom_shift  &kp LALT       &kp CLCK               &hm 8 ENTER  &kp SPACE          &kp DOWN  &kp UP           &mkp LCLK      &mkp RCLK             &mo 10
            >;
        };

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE      &kp N1             &kp N2       &kp N3       &kp N4     &kp N5  &kp PSCRN                                                                    &mo 11     &kp N6  &kp N7    &kp N8           &kp N9         &kp N0                &kp BSLH
&kp EQUAL      &kp Q              &kp W        &kp E        &kp R      &kp T   &kp INS                                                                      &kp DEL    &kp Y   &kp U     &kp I            &kp O          &kp P                 &kp MINUS
&kp TAB        &hml LCTRL A       &kp S        &kp D        &kp F      &kp G   &none      &kp LCTRL      &kp LANG2      &kp LANG1              &kp ESC      &none      &kp H   &kp J     &kp K            &kp L          &hmr LCTRL SEMI       &kp SQT
&custom_shift  &hml LC(LSHIFT) Z  &hml LGUI X  &hml LALT C  &kp V      &kp B                             &kp LGUI       &kp LS(LA(LG(LCTRL)))                          &kp N   &kp M     &hmr LALT COMMA  &hmr LGUI DOT  &hmr LC(LSHIFT) FSLH  &custom_shift
&mo 10         &kp PG_UP          &kp PG_DN    &kp LEFT     &kp RIGHT          &kp BSPC   &custom_shift  &kp LALT       &kp CLCK               &hm 8 ENTER  &kp SPACE          &kp DOWN  &kp UP           &kp LBKT       &kp RBKT              &mo 10
            >;
        };

        jis_reverse {
            display-name = "Jisa_reverse";
            bindings = <
&mj_ea         &mj_n1             &mj_n2         &mj_n3       &mj_n4     &mj_n5  &kp PSCRN                                                                    &mo 11     &mj_n6  &mj_n7    &mj_n8           &mj_n9         &mj_n0                &mj_bp
&mj_ep         &kp Q              &kp W          &kp E        &kp R      &kp T   &kp INS                                                                      &kp DEL    &kp Y   &kp U     &kp I            &kp O          &kp P                 &mj_mu
&kp TAB        &hml LCTRL A       &kp S          &kp D        &kp F      &kp G   &none      &kp LCTRL      &kp LANG2      &kp LANG1              &kp ESC      &none      &kp H   &kp J     &kp K            &kp L          &hmr_sc LCTRL 0       &mj_qd
&custom_shift  &hml LC(LSHIFT) Z  &hml LGUI X    &hml LALT C  &kp V      &kp B                             &kp LGUI       &kp LS(LA(LG(LCTRL)))                          &kp N   &kp M     &hmr LALT COMMA  &hmr LGUI DOT  &hmr LC(LSHIFT) FSLH  &custom_shift
&mo 10         &kp PG_UP          &kp PAGE_DOWN  &kp LEFT     &kp RIGHT          &kp BSPC   &custom_shift  &kp LALT       &kp CLCK               &hm 9 ENTER  &kp SPACE          &kp DOWN  &kp UP           &mkp LCLK      &mkp RCLK             &mo 10
            >;
        };

        jis {
            display-name = "Jis";
            bindings = <
&mj_gt         &kp N1             &aj_n2       &kp N3       &kp N4     &kp N5  &kp PSCRN                                                                    &mo 11     &aj_n6  &aj_n7    &aj_n8           &aj_n9         &aj_n0                &mj_bp
&mj_ep         &kp Q              &kp W        &kp E        &kp R      &kp T   &kp INS                                                                      &kp DEL    &kp Y   &kp U     &kp I            &kp O          &kp P                 &mj_mu
&kp TAB        &hml LCTRL A       &kp S        &kp D        &kp F      &kp G   &none      &kp LCTRL      &kp LANG2      &kp LANG1              &kp ESC      &none      &kp H   &kp J     &kp K            &kp L          &hmr_sc LCTRL 0       &mj_qd
&custom_shift  &hml LC(LSHIFT) Z  &hml LGUI X  &hml LALT C  &kp V      &kp B                             &kp LGUI       &kp LS(LA(LG(LCTRL)))                          &kp N   &kp M     &hmr LALT COMMA  &hmr LGUI DOT  &hmr LC(LSHIFT) FSLH  &kp N7
&mo 11         &kp PG_UP          &kp PG_DN    &kp LEFT     &kp RIGHT          &kp BSPC   &custom_shift  &kp LALT       &kp CAPS               &hm 9 ENTER  &kp SPACE          &kp DOWN  &kp UP           &kp RBKT       &kp NON_US_BSLH       &mo 11
            >;
        };

        symbols {
            bindings = <
&kp LC(LA(DEL))  &kp COMMA  &kp LPAR   &kp RPAR   &kp SEMI    &kp DOT       &trans                                      &trans  &none      &none          &none          &none   &none      &none
&kp EXCL         &kp LBKT   &kp LBRC   &kp RBRC   &kp RBKT    &kp QUESTION  &trans                                      &trans  &kp FSLH   &kp N7         &kp N8         &kp N9  &kp STAR   &kp PSCRN
