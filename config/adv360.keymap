#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&sk { release-after-ms = <150>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <150>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <148>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        hml_mod: hml_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_MOD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        hmr_mod: hmr_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR_MOD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            hold-trigger-on-release;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        mj_bp: mj_bp {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_BP";
            bindings = <&kp INT3>, <&kp LS(INT3)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_mu: mj_mu {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_MU";
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_gt: mj_gt {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_GT";
            bindings = <&kp LBRC>, <&kp PLUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_ep: mj_ep {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_EP";
            bindings = <&kp UNDER>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_qd: mj_qd {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_QD";
            bindings = <&kp AMPS>, <&kp AT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_sc: mj_sc {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_SC";
            bindings = <&kp SEMI>, <&kp SQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n1: mm_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N1";
            bindings = <&kp STAR>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n2: mm_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N2";
            bindings = <&kp LBKT>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n3: mm_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N3";
            bindings = <&kp LBRC>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n4: mm_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N4";
            bindings = <&kp LPAR>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n5: mm_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N5";
            bindings = <&kp HASH>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n6: mm_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N6";
            bindings = <&kp CARET>, <&kp N6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n7: mm_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N7";
            bindings = <&kp RPAR>, <&kp N7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n8: mm_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N8";
            bindings = <&kp RBRC>, <&kp N8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n9: mm_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N9";
            bindings = <&kp RBKT>, <&kp N9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_n0: mm_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_N0";
            bindings = <&kp DLLR>, <&kp N0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_ea: mm_ea {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_EA";
            bindings = <&kp EXCL>, <&kp AT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_pa: mm_pa {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_PA";
            bindings = <&kp PRCNT>, <&kp AMPS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n1: mj_n1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N1";
            bindings = <&kp DQT>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n2: mj_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N2";
            bindings = <&kp RBKT>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n3: mj_n3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N3";
            bindings = <&kp RBRC>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n4: mj_n4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N4";
            bindings = <&kp STAR>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n5: mj_n5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N5";
            bindings = <&kp HASH>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n6: mj_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N6";
            bindings = <&kp EQUAL>, <&kp N6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n7: mj_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N7";
            bindings = <&kp LPAR>, <&kp N7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n8: mj_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N8";
            bindings = <&kp PIPE>, <&kp N8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n9: mj_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N9";
            bindings = <&kp BSLH>, <&kp N9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_n0: mj_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_N0";
            bindings = <&kp DLLR>, <&kp N0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_ea: mj_ea {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_EA";
            bindings = <&kp EXCL>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mj_pa: mj_pa {
            compatible = "zmk,behavior-mod-morph";
            label = "MJ_PA";
            bindings = <&kp PRCNT>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        aj_n2: aj_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N2";
            bindings = <&kp N2>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n6: aj_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N6";
            bindings = <&kp N6>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n7: aj_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N7";
            bindings = <&kp N7>, <&kp CARET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n8: aj_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N8";
            bindings = <&kp N8>, <&kp DQT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n9: aj_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N9";
            bindings = <&kp N9>, <&kp STAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n0: aj_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N0";
            bindings = <&kp N0>, <&kp LPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none>,
                <&macro_press>,
                <&kp F13>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&bt BT_SEL 0>,
                <&macro_release>;

            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&none>,
                <&macro_press>,
                <&kp F14>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&bt BT_SEL 1>,
                <&macro_release>;

            label = "BT1";
        };
    };

    combos {
        compatible = "zmk,combos";

        jk_esc {
            bindings = <&kp ESC>;
            key-positions = <40 41>;
        };

        df_tab {
            bindings = <&kp TAB>;
            key-positions = <32 33>;
        };

        kl_lang1 {
            bindings = <&kp LANG1>;
            key-positions = <41 42>;
        };

        sd_lang2 {
            bindings = <&kp LANG2>;
            key-positions = <32 31>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1     &kp N2     &kp N3    &kp N4     &kp N5  &kp PSCRN                                                                            &mo 6                    &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp BSLH
&kp EQUAL  &kp Q      &kp W      &kp E     &kp R      &kp T   &kp INS                                                                              &kp DEL                  &kp Y   &kp U     &kp I      &kp O     &kp P     &kp MINUS
&kp ESC    &kp A      &kp S      &kp D     &kp F      &kp G   &kp LC(LS(LA(LG(F14))))  &kp LCTRL  &kp LALT       &kp TAB                &mo 4      &kp LC(LS(LA(LG(F13))))  &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C     &kp V      &kp B                                       &kp LGUI       &kp LS(LA(LG(LCTRL)))                                      &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 7      &kp PG_UP  &kp PG_DN  &kp LEFT  &kp RIGHT          &kp BSPC                 &kp LSHFT  &kp LANG2      &kp LANG1              &kp ENTER  &kp SPACE                        &kp DOWN  &kp UP     &kp LBKT  &kp RBKT  &mo 7
            >;
        };

        base_reverse {
            display-name = "Base_reverse";
            bindings = <
&mm_ea     &mm_n1  &mm_n2       &mm_n3   &mm_n4     &mm_n5  &kp PSCRN                                                                            &mo 6                    &mm_n6  &mm_n7    &mm_n8     &mm_n9   &mm_n0     &kp BSLH
&kp EQUAL  &kp Q   &kp W        &kp E    &kp R      &kp T   &kp INS                                                                              &kp DEL                  &kp Y   &kp U     &kp I      &kp O    &kp P      &kp MINUS
&kp GRAVE  &kp A   &kp S        &kp D    &kp F      &kp G   &kp LC(LS(LA(LG(F14))))  &kp LCTRL  &kp LALT       &kp TAB                &kp ESC    &kp LC(LS(LA(LG(F13))))  &kp H   &kp J     &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z   &kp X        &kp C    &kp V      &kp B                                       &kp LGUI       &kp LS(LA(LG(LCTRL)))                                      &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH   &kp RSHFT
&mo 7      &mm_pa  &kp LS(DEL)  &kp INS  &kp PSCRN          &kp BSPC                 &kp LSHFT  &kp LANG2      &kp LANG1              &kp ENTER  &kp SPACE                        &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &mo 7
            >;
        };

        jis {
            display-name = "Jis";
            bindings = <
&mj_gt     &kp N1     &aj_n2     &kp N3    &kp N4     &kp N5  &kp PSCRN                                                                          &mo 6                  &aj_n6  &aj_n7    &aj_n8     &aj_n9    &aj_n0           &mj_bp
&mj_ep     &kp Q      &kp W      &kp E     &kp R      &kp T   &kp INS                                                                            &kp DEL                &kp Y   &kp U     &kp I      &kp O     &kp P            &mj_mu
&kp ESC    &kp A      &kp S      &kp D     &kp G      &kp G   &kp LS(LC(LG(LCTRL)))  &kp LCTRL  &kp LALT       &kp TAB                &mo 5      &kp LS(LA(LG(LCTRL)))  &kp H   &kp J     &kp K      &kp L     &mj_sc           &mj_qd
&kp LSHFT  &kp Z      &kp X      &kp C     &kp V      &kp B                                     &kp LGUI       &kp LS(LA(LG(LCTRL)))                                    &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH         &kp RSHFT
&mo 7      &kp PG_UP  &kp PG_DN  &kp LEFT  &kp RIGHT          &kp BSPC               &kp LSHFT  &kp LANG2      &kp LANG1              &kp ENTER  &kp SPACE                      &kp DOWN  &kp UP     &kp RBKT  &kp NON_US_BSLH  &mo 7
            >;
        };

        jis_reverse {
            display-name = "Jisa_reverse";
            bindings = <
&mj_ea     &mj_n1  &mj_n2   &mj_n3   &mj_n4     &mj_n5  &kp PSCRN                                                                          &mo 6                  &mj_n6  &mj_n7    &mj_n8     &mj_n9   &mj_n0     &mj_bp
&mj_ep     &kp Q   &kp W    &kp E    &kp R      &kp T   &kp INS                                                                            &kp DEL                &kp Y   &kp U     &kp I      &kp O    &kp P      &mj_mu
&mj_gt     &kp A   &kp S    &kp D    &kp G      &kp G   &kp LS(LC(LG(LCTRL)))  &kp LCTRL  &kp LALT       &kp TAB                &kp ESC    &kp LS(LA(LG(LCTRL)))  &kp H   &kp J     &kp K      &kp L    &mj_sc     &mj_qd
&kp LSHFT  &kp Z   &kp X    &kp C    &kp V      &kp B                                     &kp LGUI       &kp LS(LA(LG(LCTRL)))                                    &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH   &kp RSHFT
&mo 7      &mj_pa  &kp DEL  &kp INS  &kp PSCRN          &kp BSPC               &kp LSHFT  &kp LANG2      &kp LANG1              &kp ENTER  &kp SPACE                      &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &mo 7
            >;
        };

        symbols {
            bindings = <
&kp LC(LA(DEL))  &kp COMMA  &kp LPAR   &kp RPAR   &kp SEMI    &kp DOT       &trans                                              &trans  &none  &none          &none          &none      &none      &none
&kp EXCL         &kp LBKT   &kp LBRC   &kp RBRC   &kp RBKT    &kp QUESTION  &trans                                              &trans  &none  &kp LC(N1)     &kp LC(N2)     &none      &none      &kp PSCRN
&kp HASH         &kp CARET  &kp EQUAL  &kp UNDER  &kp DOLLAR  &kp STAR      &trans     &kp BSLH   &kp DOT       &trans  &trans  &trans  &none  &kp BSPC       &kp TAB        &kp SPACE  &kp ENTER  &kp LA(PSCRN)
&kp TILDE        &kp LT     &kp PIPE   &kp MINUS  &kp GT      &kp FSLH                            &kp STAR      &trans                  &none  &kp DEL        &kp LS(TAB)    &none      &none      &kp LG(PSCRN)
&none            &kp AMPS   &kp SQT    &kp DQT    &kp PLUS                  &kp PRCNT  &kp COLON  &kp AT        &trans  &trans  &trans         &kp LC(PG_UP)  &kp LC(PG_DN)  &none      &none      &none
            >;

            label = "Symbols";
        };

        symbols_jis {
            bindings = <
&kp LC(LA(DEL))  &kp F1        &kp F2        &kp F3    &kp F4    &kp F5        &trans                                      &trans  &kp F6      &kp F7         &kp F8         &kp F9     &kp F10        &kp F11
&kp LC(LA(INS))  &kp INT3      &kp LS(INT3)  &kp RBRC  &kp PIPE  &kp QUESTION  &trans                                      &trans  &kp LC(N1)  &kp LC(N2)     &none          &none      &kp PSCRN      &kp F12
&kp EQUAL        &kp UNDER     &kp MINUS     &kp STAR  &kp LPAR  &kp DLLR      &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT    &kp DOWN       &kp UP         &kp RIGHT  &kp LA(PSCRN)  &kp F13
&none            &kp LS(SEMI)  &kp LS(INT1)  &kp RBKT  &kp BSLH  &kp FSLH                      &trans      &trans                  &none       &none          &none          &none      &kp LG(PSCRN)  &kp F14
&none            &none         &none         &none     &none                   &trans  &trans  &trans      &trans  &trans  &trans              &kp LC(PG_UP)  &kp LC(PG_DN)  &none      &none          &kp F15
            >;

            label = "Symbols_jis";
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none           &to 0         &to 1         &to 2         &to 3         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&studio_unlock  &bt0          &bt1          &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        function {
            bindings = <
&none   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none                                  &none  &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &kp F11
&none   &none   &none   &none   &none   &none   &none                                  &none  &none   &none     &kp UP    &none      &none    &kp F12
&none   &none   &none   &none   &none   &none   &none  &none  &none      &none  &none  &none  &none   &kp LEFT  &kp DOWN  &kp RIGHT  &none    &kp F14
&none   &none   &none   &none   &none   &none                 &none      &none                &none   &none     &none     &none      &none    &kp F15
&trans  &none   &none   &none   &none           &none  &none  &none      &none  &none  &none          &none     &none     &none      &none    &trans
            >;

            label = "Function";
        };
    };
};
