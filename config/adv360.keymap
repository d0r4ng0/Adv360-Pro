    macros {
        bt0: bt0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F13>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&bt BT_SEL 0>,
                <&macro_release>;

            label = "BT0";
        };

        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp F14>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&bt BT_SEL 1>,
                <&macro_release>;

            label = "BT1";
        };

        code: code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "CODE";
        };

        code_jis: code_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp LBRC &kp LBRC>;
            label = "CODE_JIS";
        };

        d_colon: double_colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "DOUBLE_COLON";
        };

        d_colon_jis: double_colon_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT>;
            label = "DOUBLE_COLON_JIS";
        };

        pren: pren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR>;
            label = "PREN";
        };

        pren_jis: pren_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp STAR &kp LPAR>;
            label = "PREN_JIS";
        };

        brc: brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC>;
            label = "BRC";
        };

        brc_jis: brc_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBRC &kp PIPE>;
            label = "BRC_JIS";
        };

        bkt: bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT>;
            label = "BKT";
        };

        bkt_jis: bkt_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT &kp BSLH>;
            label = "BKT_JIS";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base_reverse {
            display-name = "Base_reverse";
            bindings = <
&mm_ea            &mm_n1             &mm_n2                    &mm_n3       &mm_n4       &mm_n5         &kp PSCRN                                                                  &mo 14     &mm_n6         &mm_n7       &mm_n8          &mm_n9                       &mm_n0                &kp BSLH
&kp EQUAL         &kp Q              &kp W                     &kp E        &kp R        &kp T          &kp INS                                                                    &kp DEL    &kp Y          &kp U        &kp I           &kp O                        &kp P                 &kp MINUS
&hml LCTRL GRAVE  &kp A              &kp S                     &kp D        &kp F        &kp G          &none      &kp LCTRL      &kp LALT       &kp TAB                &kp ESC    &none      &kp H          &kp J        &kp K           &kp L                        &kp SEMI              &hmr LCTRL SQT
&mm_lp            &hml LC(LSHIFT) Z  &hml LS(LA(LG(LCTRL))) X  &hml LALT C  &hml LGUI V  &hml_mod 13 B                            &kp LGUI       &kp LS(LA(LG(LCTRL)))                        &hmr_mod 13 N  &hmr LGUI M  &hmr_cc LALT 0  &hmr_dd LS(LA(LG(LCTRL))) 0  &hmr LC(LSHIFT) FSLH  &mm_ga
&mo 13            &kp PG_UP          &kp PAGE_DOWN             &kp LEFT     &kp RIGHT                   &kp BSPC   &custom_shift  &kp LANG2      &kp LANG1              &kp ENTER  &kp SPACE                 &kp DOWN     &kp UP          &mkp LCLK                    &mkp RCLK             &mo 13
            >;
        };

        default_layer {
            display-name = "Base";
            bindings = <
&kp DEL           &kp N1             &kp N2                    &kp N3       &kp N4       &kp N5         &kp PSCRN                                                                  &mo 14     &kp N6         &kp N7       &kp N8           &kp N9                      &kp N0                &kp BSLH
&kp EQUAL         &kp Q              &kp W                     &kp E        &kp R        &kp T          &kp INS                                                                    &kp DEL    &kp Y          &kp U        &kp I            &kp O                       &kp P                 &kp MINUS
&hml LCTRL GRAVE  &kp A              &kp S                     &kp D        &kp F        &kp G          &none      &kp LCTRL      &kp LALT       &kp TAB                &kp ESC    &none      &kp H          &kp J        &kp K            &kp L                       &kp SEMI              &hmr LCTRL SQT
