        mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        aj_n2: aj_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N2";
            bindings = <&kp N2>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        aj_n6: aj_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "AJ_N6";
            bindings = <&kp N6>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
